{
  "name": "inventario-computadoras-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run src/inventory.test.ts src/cloudSync.test.ts src/cloudSync.unconfigured.test.ts",
    "test:rules": "vitest run src/firestore.rules.test.ts",
    "test:rules:emulator": "firebase emulators:exec --only firestore --project inventario-computadoras-rules-test \"npm run test:rules\"",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "worker:check": "npm --prefix worker run check",
    "worker:deploy": "npm --prefix worker run deploy",
    "generate:icons": "node scripts/generate-icons.mjs",
    "ios": "powershell -ExecutionPolicy Bypass -File scripts/start-ios.ps1"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "exceljs": "^4.4.0",
    "firebase": "^13.0.0",
    "idb": "^8.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.7.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.2",
    "firebase-tools": "^15.33.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "uuid": "11.1.1"
  }
}
