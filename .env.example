# Copia este archivo como .env.local. No confirmes .env.local en Git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Dominio propio de Vercel cuando /__/auth/* se proxy a Firebase.
VITE_FIREBASE_AUTH_DOMAIN_OVERRIDE=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mantener false mientras el proyecto no tenga Cloud Storage habilitado con autorización de facturación.
VITE_FIREBASE_STORAGE_ENABLED=false

# URL HTTPS del Cloudflare Worker. Déjala vacía hasta configurar su secreto y probarlo en producción.
VITE_IMAGEKIT_BACKEND_URL=
